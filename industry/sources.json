    {
      "id": "json-hf-spaces-trending",
      "name": "Hugging Face Spaces · 热门",
      "kind": "json_list",
      "config": {
        "url": "https://huggingface.co/api/trending?type=space",
        "mode": "json_api",
        "itemsPath": "recentlyTrending",
        "titlePaths": ["repoData.title", "repoData.id"],
        "summaryPaths": ["repoData.shortDescription", "repoData.ai_short_description"],
        "authorPaths": ["repoData.author"],
        "publishedAtPath": "repoData.lastModified",
        "externalIdPath": "repoData.id",
        "urlTemplate": "https://huggingface.co/spaces/{raw:repoData.id}",
        "minNumeric": {
          "path": "repoData.likes",
          "min": 30
        },
        "_aihot": {
          "initialBackfillLimit": 10
        }
      },
      "tier": "T1_5",
      "first_party": false,
      "owner_entity_id": "hugging-face",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "平台数据",
        "工具"
